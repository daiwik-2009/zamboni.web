<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZamboniAI - AI Hockey Coaching & Skill Development</title>
    <style>
        :root {
            --primary: #00d2ff;
            --primary-dark: #0072ff;
            --bg-dark: #0a1118;
            --bg-card: #121e2b;
            --text-light: #f4f7f6;
            --text-muted: #8fa0b0;
            --accent: #ff007f;
            --success: #00ff87;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 5%;
            background: rgba(10, 17, 24, 0.9);
            backdrop-filter: blur(10px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid rgba(0, 210, 255, 0.1);
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-light);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            letter-spacing: 1px;
        }

        .logo span {
            color: var(--primary);
            text-shadow: 0 0 10px rgba(0, 210, 255, 0.5);
        }

        nav a {
            color: var(--text-light);
            text-decoration: none;
            margin-left: 2rem;
            font-weight: 500;
            transition: color 0.3s;
        }

        nav a:hover, nav a.active {
            color: var(--primary);
        }

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8rem 5% 4rem;
            background: radial-gradient(circle at 80% 20%, rgba(0, 114, 255, 0.15), transparent 50%),
                        radial-gradient(circle at 20% 80%, rgba(0, 210, 255, 0.05), transparent 40%);
            gap: 2rem;
        }

        .hero-content {
            flex: 1;
            max-width: 600px;
        }

        .hero-tagline {
            color: var(--primary);
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 2px;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 1.5rem;
        }

        .hero h1 span {
            background: linear-gradient(45deg, var(--primary), var(--primary-dark));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            color: var(--text-muted);
            font-size: 1.2rem;
            margin-bottom: 2.5rem;
        }

        .cta-buttons {
            display: flex;
            gap: 1rem;
        }

        .btn {
            display: inline-block;
            padding: 0.8rem 2rem;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .btn-primary {
            background: linear-gradient(45deg, var(--primary-dark), var(--primary));
            color: var(--bg-dark);
            box-shadow: 0 4px 15px rgba(0, 210, 255, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 210, 255, 0.5);
        }

        .btn-secondary {
            border: 2px solid rgba(255, 255, 255, 0.1);
            color: var(--text-light);
        }

        .btn-secondary:hover {
            border-color: var(--primary);
            background: rgba(0, 210, 255, 0.05);
        }

        .hero-image {
            flex: 1;
            display: flex;
            justify-content: center;
            position: relative;
        }

        .mockup-container {
            width: 320px;
            height: 640px;
            background: #000;
            border: 12px solid #222;
            border-radius: 40px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5), 0 0 30px rgba(0, 210, 255, 0.2);
            position: relative;
            overflow: hidden;
        }

        /* App Simulation Styling */
        .app-screen {
            width: 100%;
            height: 100%;
            background: var(--bg-dark);
            display: flex;
            flex-direction: column;
            font-size: 0.9rem;
        }

        .app-header {
            background: var(--bg-card);
            padding: 1rem;
            text-align: center;
            border-bottom: 1px solid rgba(0,210,255,0.1);
            font-weight: 700;
            color: var(--primary);
        }

        .app-content {
            flex: 1;
            padding: 1rem;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .chat-bubble {
            padding: 0.75rem 1rem;
            border-radius: 15px;
            max-width: 85%;
            margin-bottom: 0.5rem;
            animation: fadeIn 0.3s ease forwards;
        }

        .chat-coach {
            background: var(--bg-card);
            border-bottom-left-radius: 2px;
            align-self: flex-start;
            border-left: 3px solid var(--primary);
        }

        .chat-user {
            background: var(--primary-dark);
            border-bottom-right-radius: 2px;
            align-self: flex-end;
            color: white;
        }

        .app-input-area {
            padding: 0.75rem;
            background: var(--bg-card);
            border-top: 1px solid rgba(0,210,255,0.1);
            display: flex;
            gap: 0.5rem;
        }

        .app-input {
            flex: 1;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(0,210,255,0.2);
            border-radius: 20px;
            padding: 0.5rem 1rem;
            color: white;
            font-size: 0.8rem;
        }

        .app-send {
            background: var(--primary);
            border: none;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Section generic styles */
        section {
            padding: 6rem 5%;
        }

        .section-header {
            text-align: center;
            max-width: 700px;
            margin: 0 auto 4rem;
        }

        .section-header h2 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
        }

        .section-header p {
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        /* Features Section */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1max));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .feature-card {
            background: var(--bg-card);
            padding: 2.5rem;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.03);
            transition: all 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            border-color: rgba(0, 210, 255, 0.2);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .feature-icon {
            width: 50px;
            height: 50px;
            background: rgba(0, 210, 255, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 1.5rem;
        }

        .feature-card h3 {
            font-size: 1.4rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .feature-card p {
            color: var(--text-muted);
        }

        /* Academy Interactive Preview Modules */
        .academy-container {
            max-width: 1000px;
            margin: 0 auto;
            background: var(--bg-card);
            border-radius: 24px;
            border: 1px solid rgba(0, 210, 255, 0.1);
            overflow: hidden;
        }

        .academy-tabs {
            display: flex;
            background: rgba(0,0,0,0.2);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .tab-btn {
            flex: 1;
            padding: 1.2rem;
            background: none;
            border: none;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
        }

        .tab-btn:hover {
            color: var(--text-light);
            background: rgba(255,255,255,0.02);
        }

        .tab-btn.active {
            color: var(--primary);
            background: var(--bg-card);
            border-bottom: 3px solid var(--primary);
        }

        .panel-content {
            padding: 3rem;
            display: none;
        }

        .panel-content.active {
            display: block;
            animation: fadeIn 0.5s ease;
        }

        .lesson-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
